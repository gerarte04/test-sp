# Скопируйте в .env и заполните. Файл .env добавлен в .gitignore.

# Провайдер: anthropic | openai
#   openai — любой OpenAI-совместимый API (OpenAI, Ollama, LM Studio, vLLM и т.п.)
LLM_PROVIDER=anthropic

# --- Anthropic ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- OpenAI-совместимый API ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# Пример для локальной модели через Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:14b
# OPENAI_API_KEY=ollama

# --- Общие настройки ---
# Таймаут одного запроса к LLM, секунды
LLM_TIMEOUT=60
# Сколько раз модель может переписать ответ, если он не прошёл проверки
LLM_MAX_ATTEMPTS=2
# Температура — только для OpenAI-совместимого API
LLM_TEMPERATURE=0.2
